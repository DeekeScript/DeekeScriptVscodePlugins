{
  "name": "deekescript",
  "displayName": "DeekeScript",
  "description": "DeekeScript扩展，协助用户开发",
  "version": "1.2.2",
  "icon": "resources/logo.png",
  "publisher": "DeekeScript",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Language Packs"
  ],
  "keywords": [
    "Deeke",
    "Deeke.cn",
    "DeekeScript",
    "Automation scripts",
    "DeekeScript Development Tools"
  ],
  "author": {
    "name": "DeekeScript"
  },
  "homepage": "https://github.com/DeekeScript/DeekeScriptVscodePlugins",
  "bugs": {
    "url": "https://github.com/DeekeScript",
    "email": "miniphper@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DeekeScript/DeekeScriptVscodePlugins.git"
  },
  "pricing": "Free",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "completionProvider": {
      "resolveProvider": "true",
      "triggerCharacters": [
        "/[sS]+/"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "deekeScript.serverRun",
        "title": "DeekeScript：连接手机",
        "icon": "$(link)"
      },
      {
        "command": "deekeScript.stopAll",
        "title": "DeekeScript：停止所有脚本",
        "icon": "$(debug-stop)"
      },
      {
        "command": "deekeScript.fileSync",
        "title": "DeekeScript：文件同步",
        "icon": "$(sync)"
      },
      {
        "command": "deekeScript.run",
        "title": "DeekeScript：仅当前文件执行",
        "icon": "$(testing-run-icon)"
      },
      {
        "command": "deekeScript.projectRun",
        "title": "DeekeScript：项目执行",
        "icon": "$(testing-run-icon)"
      },
      {
        "command": "deekeScript.projectSync",
        "title": "DeekeScript：项目同步",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "deekeScript.serverClose",
        "title": "DeekeScript：关闭连接",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "deekeScript.resetRetry",
        "title": "DeekeScript：重置重连状态",
        "icon": "$(refresh)"
      },
      {
        "command": "deekeScript.showStatus",
        "title": "DeekeScript：显示状态",
        "icon": "$(info)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "DeekeScript配置",
      "properties": {
        "server.port": {
          "type": "number",
          "default": 8088,
          "scope": "window",
          "description": "WebSocket服务端的端口号"
        },
        "server.wsMaxRetries": {
          "type": "number",
          "default": 59,
          "description": "最大重连次数"
        },
        "server.wsBaseDelay": {
          "type": "number",
          "default": 1000,
          "description": "基础重连延迟(ms)"
        },
        "logging.level": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "default": "info",
          "description": "日志输出级别"
        },
        "logging.enableColors": {
          "type": "boolean",
          "default": true,
          "description": "是否启用彩色日志输出"
        },
        "logging.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "是否显示通知消息"
        },
        "sync.debounceDelay": {
          "type": "number",
          "default": 500,
          "description": "文件同步防抖延迟(ms)"
        },
        "sync.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "是否自动同步文件变更"
        },
        "sync.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["node_modules", ".git", ".vscode"],
          "description": "文件同步排除模式"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "when": "editorFocus",
          "command": "deekeScript.fileSync",
          "group": "navigation"
        },
        {
          "when": "resourceFilename == 'deekeScript.json'",
          "command": "deekeScript.serverRun",
          "group": "navigation"
        },
        {
          "when": "resourceFilename == 'deekeScript.json'",
          "command": "deekeScript.projectSync",
          "group": "navigation"
        },
        {
          "when": "resourceFilename == 'deekeScript.json'",
          "command": "deekeScript.serverClose",
          "group": "navigation"
        },
        {
          "when": "editorLangId == 'javascript'",
          "command": "deekeScript.run",
          "group": "navigation"
        },
        {
          "when": "editorTextFocus",
          "command": "deekeScript.stopAll",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "vscode:package": "vsce package",
    "vscode:publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/source-map": "^0.5.7",
    "@types/vscode": "^1.96.0",
    "@types/ws": "^8.18.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.56.0",
    "source-map": "^0.7.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "vscode": "^1.1.34",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "optionalDependencies": {
    "utf-8-validate": "^6.0.3"
  },
  "dependencies": {
    "@vscode/vsce": "^3.2.1",
    "isomorphic-ws": "^5.0.0",
    "vsce": "^1.97.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "ws": "^8.18.3"
  }
}
