{
  "name": "deekescript-pro",
  "displayName": "DeekeScript Pro",
  "description": "DeekeScript Pro 官方 VS Code 扩展：连接手机端 Pro 运行时，同步工程、调试脚本，并提供 API 智能提示。",
  "version": "2.0.2",
  "icon": "resources/logo.png",
  "publisher": "DeekeScript",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "keywords": [
    "Deeke",
    "Deeke.cn",
    "DeekeScript Pro",
    "DeekeScript",
    "Android",
    "RPA",
    "Automation",
    "Android Automation",
    "script.deeke.cn"
  ],
  "author": {
    "name": "DeekeScript"
  },
  "homepage": "https://script.deeke.cn",
  "bugs": {
    "url": "https://github.com/DeekeScript",
    "email": "miniphper@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DeekeScript/DeekeScriptVscodePlugins.git"
  },
  "pricing": "Free",
  "activationEvents": [
    "workspaceContains:deekeScript.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "deekeScriptPro.serverRun",
        "title": "DeekeScript Pro：连接手机",
        "icon": "$(link)"
      },
      {
        "command": "deekeScriptPro.stopAll",
        "title": "DeekeScript Pro：停止所有脚本",
        "icon": "$(debug-stop)"
      },
      {
        "command": "deekeScriptPro.fileSync",
        "title": "DeekeScript Pro：文件同步",
        "icon": "$(sync)"
      },
      {
        "command": "deekeScriptPro.run",
        "title": "DeekeScript Pro：仅当前文件执行",
        "icon": "$(testing-run-icon)"
      },
      {
        "command": "deekeScriptPro.projectRun",
        "title": "DeekeScript Pro：项目执行",
        "icon": "$(testing-run-icon)"
      },
      {
        "command": "deekeScriptPro.projectSync",
        "title": "DeekeScript Pro：项目同步",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "deekeScriptPro.serverClose",
        "title": "DeekeScript Pro：关闭连接",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "deekeScriptPro.resetRetry",
        "title": "DeekeScript Pro：重置重连状态",
        "icon": "$(refresh)"
      },
      {
        "command": "deekeScriptPro.showStatus",
        "title": "DeekeScript Pro：显示状态",
        "icon": "$(info)"
      }
    ],
    "configuration": {
      "title": "DeekeScript Pro",
      "properties": {
        "deekeScriptPro.server.port": {
          "type": "number",
          "default": 8088,
          "scope": "window",
          "description": "连接 DeekeScript Pro 手机端时使用的 WebSocket 端口"
        },
        "deekeScriptPro.server.wsMaxRetries": {
          "type": "number",
          "default": 59,
          "description": "WebSocket 最大重连次数"
        },
        "deekeScriptPro.server.wsBaseDelay": {
          "type": "number",
          "default": 1000,
          "description": "WebSocket 基础重连延迟（毫秒）"
        },
        "deekeScriptPro.logging.level": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "default": "info",
          "description": "扩展日志输出级别"
        },
        "deekeScriptPro.logging.enableColors": {
          "type": "boolean",
          "default": true,
          "description": "是否在输出通道中启用彩色日志"
        },
        "deekeScriptPro.logging.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "是否在操作完成或失败时显示通知"
        },
        "deekeScriptPro.sync.debounceDelay": {
          "type": "number",
          "default": 500,
          "description": "自动同步防抖延迟（毫秒）"
        },
        "deekeScriptPro.sync.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "是否在文件变更后自动同步到手机"
        },
        "deekeScriptPro.sync.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["node_modules", ".git", ".vscode"],
          "description": "同步到手机时排除的路径模式"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "when": "editorFocus",
          "command": "deekeScriptPro.fileSync",
          "group": "navigation"
        },
        {
          "when": "resourceFilename == 'deekeScript.json'",
          "command": "deekeScriptPro.serverRun",
          "group": "navigation"
        },
        {
          "when": "resourceFilename == 'deekeScript.json'",
          "command": "deekeScriptPro.projectSync",
          "group": "navigation"
        },
        {
          "when": "resourceFilename == 'deekeScript.json'",
          "command": "deekeScriptPro.serverClose",
          "group": "navigation"
        },
        {
          "when": "editorLangId == 'javascript'",
          "command": "deekeScriptPro.run",
          "group": "navigation"
        },
        {
          "when": "editorTextFocus",
          "command": "deekeScriptPro.stopAll",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "vscode:package": "vsce package",
    "vscode:publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/source-map": "^0.5.7",
    "@types/vscode": "^1.96.0",
    "@types/ws": "^8.18.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.56.0",
    "source-map": "^0.7.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "vscode": "^1.1.34",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "optionalDependencies": {
    "utf-8-validate": "^6.0.3"
  },
  "dependencies": {
    "@vscode/vsce": "^3.2.1",
    "isomorphic-ws": "^5.0.0",
    "vsce": "^1.97.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "ws": "^8.18.3"
  }
}
